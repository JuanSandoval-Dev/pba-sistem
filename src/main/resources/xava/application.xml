<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE application SYSTEM "dtds/application.dtd">

<application name="pbasistem">
    <!-- OpenXava genera un modulo CRUD para cada entidad -->
    <default-module>
        <controller name="Typical"/>
    </default-module>

    <module name="PedidosPorEstado" folder="Reportes">
        <env-var name="XAVA_LIST_ACTION" value=""/>
        <model name="Pedido"/>
        <tab name="PedidosPorEstado"/>
        <controller name="Print"/>
        <controller name="ReportePedidos"/>
    </module>

    <module name="ProductosMasVendidos" folder="Reportes">
        <env-var name="XAVA_LIST_ACTION" value=""/>
        <model name="Producto"/>
        <tab name="ProductosMasVendidos"/>
        <controller name="Print"/>
        <controller name="ReporteProductos"/>
    </module>

    <module name="ReclamosPorEstado" folder="Reportes">
        <env-var name="XAVA_LIST_ACTION" value=""/>
        <model name="Postventa"/>
        <tab name="ReclamosPorEstado"/>
        <controller name="Print"/>
        <controller name="ReporteReclamos"/>
    </module>
</application>
