<?xml version = "1.0" encoding = "ISO-8859-1"?>

<!DOCTYPE controllers SYSTEM "dtds/controllers.dtd">

<controllers>
    
    <!-- Environment variable:
    <env-var name="pbasistem_DEFAULT_YEAR" value="2015"/> 
    -->
    
    <!-- Session object:
    <object name="pbasistem_activeYear" class="java.lang.Integer" value="2015" 
    	    scope="global"/>    
    -->
    
    <controller name="ReportePedidos">
        <action name="actualizar" label="Actualizar reporte" icon="refresh"
                mode="list" on-init="true"
                class="com.pba.pbasistem.actions.MostrarResumenReporteAction">
            <set property="tipoReporte" value="PEDIDOS"/>
        </action>
    </controller>

    <controller name="ReporteProductos">
        <action name="actualizar" label="Actualizar reporte" icon="refresh"
                mode="list" on-init="true"
                class="com.pba.pbasistem.actions.MostrarResumenReporteAction">
            <set property="tipoReporte" value="PRODUCTOS"/>
        </action>
    </controller>

    <controller name="ReporteReclamos">
        <action name="actualizar" label="Actualizar reporte" icon="refresh"
                mode="list" on-init="true"
                class="com.pba.pbasistem.actions.MostrarResumenReporteAction">
            <set property="tipoReporte" value="RECLAMOS"/>
        </action>
    </controller>
    
</controllers>
